<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <style> 

        span {
            text-decoration: line-through;

        }
    </style>
</head>
<body>
    <h1>Todo List</h1>
    <a href="/all-tasks">All Tasks</a>
    |
    <a href="/completed-tasks">Completed Tasks</a>

    <% if (tasks.length > 0) { %>
        <% for (let i = 0; i < tasks.length; i++) {  %>
            ID: <%= tasks[i].id %>
            
            <!-- cross out completed tasks -->
            <% if (tasks[i].isCompleted) { %>
                <span><%= tasks[i].name %></span>
            <% } else { %>
                <%= tasks[i].name %>
            <% } %>
            <!--  -->

            <form method="POST" action="/update-task/<%= tasks[i].id %>">
                <input type="checkbox" name="home_check_box" <% if (tasks[i].isCompleted) { %> checked <% } %>>
                <button type="submit">Update</button>
            </form>
        
        <% } %>

    <% } %>
      

    <h1>Add a Task</h1>
    <form method="POST" action="/add-task">
        <label for="">Task Name: </label>
        <input type="text" name="home_add_task">
        <button type="submit">Add Task</button>
    </form>
</body>
</html>